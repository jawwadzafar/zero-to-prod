# /etc/snip/snip.env — read by snip.service. Never commit the real file.
SNIP_HTTP_ADDR=127.0.0.1:8080
SNIP_BASE_URL=https://snip.example
SNIP_DATABASE_URL=postgres://snip:CHANGE_ME@localhost:5432/snip?sslmode=disable
SNIP_REDIS_ADDR=localhost:6379
# The requirepass from /etc/redis/redis.conf. (systemd has no end-of-line
# comments: everything after = is the value.)
SNIP_REDIS_PASSWORD=CHANGE_ME
# When Redis is on another machine and serves TLS:
# SNIP_REDIS_TLS=true
SNIP_LOG_FORMAT=json
